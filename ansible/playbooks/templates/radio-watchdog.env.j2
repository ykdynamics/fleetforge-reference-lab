# Managed by ansible/playbooks/gateway-radio-watchdog.yml; read by radio-watchdog.sh.
ADAPTER={{ radio_adapter }}
CONTAINER=ff-lab-zigbee2mqtt
BROKER=ff-lab-mosquitto
TOPIC=zigbee2mqtt/+
SILENCE_S={{ radio_watchdog_silence_s }}
COOLDOWN_S={{ radio_watchdog_cooldown_s }}
USB_HUBS="{{ radio_watchdog_usb_hubs }}"
